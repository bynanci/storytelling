{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:storytelling:commercial-copy:1",
  "title": "Storytelling CommercialCopyDocumentV1",
  "$comment": "SPDX-License-Identifier: MIT. Shape constraints only; source ledger identity, reference status, duplicate-key checks and reference-only scope are defined in docs/narrative/COMMERCIAL_COPY_V1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "copy_id",
    "copy_revision",
    "evidence_document_id",
    "purpose",
    "audience",
    "claims",
    "call_to_action"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "copy_id": { "$ref": "#/$defs/id" },
    "copy_revision": { "$ref": "#/$defs/revision" },
    "evidence_document_id": { "$ref": "#/$defs/id" },
    "purpose": { "$ref": "#/$defs/shortText" },
    "audience": { "$ref": "#/$defs/shortText" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/claim" }
    },
    "call_to_action": { "$ref": "#/$defs/claim" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 512 },
    "text": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "revision"],
      "properties": {
        "unit_id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/revision" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "wording", "evidence_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["factual_claim", "creative_proposal"] },
        "wording": { "$ref": "#/$defs/text" },
        "evidence_refs": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/reference" }
        }
      }
    }
  }
}
