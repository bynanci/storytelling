{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:storytelling:narrative-video-coverage:1",
  "title": "Storytelling NarrativeVideoCoverageV1",
  "$comment": "SPDX-License-Identifier: MIT. Shape constraints only. Cross-reference, revision, order, bounds and diagnostic semantics are defined by docs/adr/0010-narrative-video-coverage-v1.md. The referenced NarrativeDocumentV1 schema must be registered by its canonical URI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "coverage_id",
    "narrative_document",
    "variant_id",
    "selected_unit_refs",
    "asset_catalog",
    "mappings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "coverage_id": { "$ref": "#/$defs/id" },
    "narrative_document": { "$ref": "urn:storytelling:narrative-document:1" },
    "variant_id": { "$ref": "#/$defs/id" },
    "selected_unit_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/unit_ref" }
    },
    "asset_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "revision", "assets"],
      "properties": {
        "catalog_id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/positive_u32" },
        "assets": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/asset" }
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/mapped" },
          { "$ref": "#/$defs/unresolved" }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "minLength": 1,
      "maxLength": 128
    },
    "positive_u32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "unit_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "revision"],
      "properties": {
        "unit_id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/positive_u32" }
      }
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "maxLength": 20
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "revision", "duration"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/positive_u32" },
        "duration": { "$ref": "#/$defs/rational" }
      }
    },
    "asset_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "revision"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/positive_u32" }
      }
    },
    "source_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/rational" },
        "end": { "$ref": "#/$defs/rational" }
      }
    },
    "mapped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_ref", "status", "asset_ref", "source_range"],
      "properties": {
        "unit_ref": { "$ref": "#/$defs/unit_ref" },
        "status": { "const": "mapped" },
        "asset_ref": { "$ref": "#/$defs/asset_ref" },
        "source_range": { "$ref": "#/$defs/source_range" }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_ref", "status", "reason"],
      "properties": {
        "unit_ref": { "$ref": "#/$defs/unit_ref" },
        "status": { "const": "unresolved" },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  }
}
