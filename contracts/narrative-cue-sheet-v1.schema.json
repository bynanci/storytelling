{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bynanci/storytelling/contracts/narrative-cue-sheet-v1.schema.json",
  "title": "Narrative Cue Sheet V1",
  "description": "A closed audio cue-sheet contract bound to one NarrativeDocumentV1 spoken variant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cue_sheet_id",
    "cue_sheet_revision",
    "document_id",
    "document_revision",
    "variant_id",
    "time_unit",
    "tracks",
    "assets",
    "cues"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "cue_sheet_id": { "$ref": "#/$defs/id" },
    "cue_sheet_revision": { "$ref": "#/$defs/revision" },
    "document_id": { "$ref": "#/$defs/id" },
    "document_revision": { "$ref": "#/$defs/revision" },
    "variant_id": { "$ref": "#/$defs/id" },
    "time_unit": { "const": "milliseconds" },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/track" }
    },
    "assets": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/asset" }
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/cue" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "revision": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "channel", "policy"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "channel": { "enum": ["voice", "sound_effect", "marker"] },
        "policy": { "enum": ["exclusive", "mixable", "marker"] }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "media_kind", "relative_path", "sha256", "provenance", "duration_ms"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/revision" },
        "media_kind": { "const": "audio" },
        "relative_path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "provenance": { "const": "synthetic" },
        "duration_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "variant_id", "beat_id", "unit_id", "revision"],
          "properties": {
            "kind": { "const": "narrative_beat" },
            "variant_id": { "$ref": "#/$defs/id" },
            "beat_id": { "$ref": "#/$defs/id" },
            "unit_id": { "$ref": "#/$defs/id" },
            "revision": { "$ref": "#/$defs/revision" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "asset_id", "revision"],
          "properties": {
            "kind": { "const": "audio_asset" },
            "asset_id": { "$ref": "#/$defs/id" },
            "revision": { "$ref": "#/$defs/revision" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "description"],
          "properties": {
            "kind": { "const": "editorial_choice" },
            "description": { "type": "string", "minLength": 1, "maxLength": 8192 }
          }
        }
      ]
    },
    "duration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value_ms"],
          "properties": {
            "status": { "const": "known" },
            "value_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value_ms"],
          "properties": {
            "status": { "const": "estimated" },
            "value_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "unknown" } }
        }
      ]
    },
    "timing": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "start_ms", "end_ms", "status"],
          "properties": {
            "kind": { "const": "absolute" },
            "start_ms": { "type": "integer", "minimum": 0 },
            "end_ms": { "type": "integer", "minimum": 0 },
            "status": { "enum": ["known", "estimated"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "cue_id", "duration"],
          "properties": {
            "kind": { "const": "after" },
            "cue_id": { "$ref": "#/$defs/id" },
            "duration": { "$ref": "#/$defs/duration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "unknown" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 8192 }
          }
        }
      ]
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "kind", "role", "track_id", "source", "instruction", "timing"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 1, "maximum": 512 },
        "kind": { "enum": ["narration", "silence", "sound_effect"] },
        "role": { "type": "string", "minLength": 1, "maxLength": 128 },
        "track_id": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/source" },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "timing": { "$ref": "#/$defs/timing" }
      }
    }
  }
}
