{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:storytelling:narrative-video-coverage-result:1",
  "title": "Storytelling NarrativeVideoCoverageResultV1",
  "$comment": "SPDX-License-Identifier: MIT. Shape constraints only. Status consistency and stable byte serialization are defined by docs/adr/0010-narrative-video-coverage-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "coverage_id",
    "narrative_ref",
    "asset_catalog_ref",
    "selected_unit_refs",
    "mappings",
    "ready_for_planning",
    "diagnostics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile": { "const": "storytelling.narrative-video-coverage.v1" },
    "coverage_id": { "$ref": "#/$defs/id" },
    "narrative_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "document_revision", "variant_id"],
      "properties": {
        "document_id": { "$ref": "#/$defs/id" },
        "document_revision": { "$ref": "#/$defs/positive_u32" },
        "variant_id": { "$ref": "#/$defs/id" }
      }
    },
    "asset_catalog_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "revision"],
      "properties": {
        "catalog_id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/positive_u32" }
      }
    },
    "selected_unit_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/unit_ref" }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/mapped" },
          { "$ref": "#/$defs/unresolved" }
        ]
      }
    },
    "ready_for_planning": { "type": "boolean" },
    "diagnostics": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "minLength": 1,
      "maxLength": 128
    },
    "positive_u32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "unit_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "revision"],
      "properties": {
        "unit_id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/positive_u32" }
      }
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "maxLength": 20
        }
      }
    },
    "asset_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "revision"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/positive_u32" }
      }
    },
    "source_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/rational" },
        "end": { "$ref": "#/$defs/rational" }
      }
    },
    "mapped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_ref", "status", "asset_ref", "source_range"],
      "properties": {
        "unit_ref": { "$ref": "#/$defs/unit_ref" },
        "status": { "const": "mapped" },
        "asset_ref": { "$ref": "#/$defs/asset_ref" },
        "source_range": { "$ref": "#/$defs/source_range" }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_ref", "status", "reason"],
      "properties": {
        "unit_ref": { "$ref": "#/$defs/unit_ref" },
        "status": { "const": "unresolved" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path"],
      "properties": {
        "code": { "const": "video_coverage.unresolved_required" },
        "path": {
          "type": "string",
          "pattern": "^\\$\\.mappings\\[[0-9]+\\]$"
        }
      }
    }
  }
}
