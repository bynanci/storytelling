{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:storytelling:narrative-revision-ledger:1",
  "title": "Storytelling NarrativeRevisionLedgerV1",
  "$comment": "SPDX-License-Identifier: MIT. Shape constraints only. Resolve the base document reference using contracts/narrative-document-v1.schema.json; replay and revision semantics are defined by docs/narrative/NARRATIVE_REVISION_LEDGER_V1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_document", "events"],
  "properties": {
    "schema_version": { "const": 1 },
    "base_document": { "$ref": "urn:storytelling:narrative-document:1" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "variant_id", "proposal_ref", "text"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "kind": { "const": "assistant_suggestion" },
              "variant_id": { "$ref": "#/$defs/id" },
              "proposal_ref": { "$ref": "#/$defs/reference" },
              "text": { "$ref": "#/$defs/text" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "variant_id", "proposal_ref", "decision", "content"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "kind": { "const": "author_decision" },
              "variant_id": { "$ref": "#/$defs/id" },
              "proposal_ref": { "$ref": "#/$defs/reference" },
              "decision": { "enum": ["accepted", "edited", "declined"] },
              "content": { "$ref": "#/$defs/text" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "unit_id", "expected_revision", "text"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "kind": { "const": "source_revision" },
              "unit_id": { "$ref": "#/$defs/id" },
              "expected_revision": { "$ref": "#/$defs/revision" },
              "text": { "$ref": "#/$defs/text" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "variant_id", "source_refs", "content"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "kind": { "const": "variant_review" },
              "variant_id": { "$ref": "#/$defs/id" },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 512,
                "items": { "$ref": "#/$defs/reference" }
              },
              "content": { "$ref": "#/$defs/text" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "text": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "revision"],
      "properties": {
        "unit_id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/revision" }
      }
    }
  }
}
