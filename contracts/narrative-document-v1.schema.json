{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:storytelling:narrative-document:1",
  "title": "Storytelling NarrativeDocumentV1",
  "$comment": "SPDX-License-Identifier: MIT. Shape constraints only; duplicate-key, byte/depth, ID/reference/revision, derivation, relation and ordering semantics are defined by docs/narrative/NARRATIVE_DOCUMENT_V1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_revision",
    "purpose",
    "audience",
    "units",
    "relations",
    "variants"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "minLength": 1,
      "maxLength": 128
    },
    "document_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "origin",
          "text",
          "based_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "minLength": 1,
            "maxLength": 128
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "origin": {
            "enum": [
              "supplied_observation",
              "author_interpretation",
              "creative_proposal"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "based_on": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit_id",
                "revision"
              ],
              "properties": {
                "unit_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                  "minLength": 1,
                  "maxLength": 128
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "origin": {
                  "const": "supplied_observation"
                }
              },
              "required": [
                "origin"
              ]
            },
            "then": {
              "properties": {
                "based_on": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "origin": {
                  "enum": [
                    "author_interpretation",
                    "creative_proposal"
                  ]
                }
              },
              "required": [
                "origin"
              ]
            },
            "then": {
              "properties": {
                "based_on": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "from",
              "to"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                "minLength": 1,
                "maxLength": 128
              },
              "kind": {
                "const": "association"
              },
              "from": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "unit_id",
                  "revision"
                ],
                "properties": {
                  "unit_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  }
                }
              },
              "to": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "unit_id",
                  "revision"
                ],
                "properties": {
                  "unit_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "variant_id",
              "before",
              "after"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                "minLength": 1,
                "maxLength": 128
              },
              "kind": {
                "const": "must_precede"
              },
              "variant_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                "minLength": 1,
                "maxLength": 128
              },
              "before": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "unit_id",
                  "revision"
                ],
                "properties": {
                  "unit_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  }
                }
              },
              "after": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "unit_id",
                  "revision"
                ],
                "properties": {
                  "unit_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  }
                }
              }
            }
          }
        ]
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "kind",
              "beats"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "kind": {
                "const": "spoken_outline"
              },
              "beats": {
                "type": "array",
                "minItems": 1,
                "maxItems": 512,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "unit_ref",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "unit_ref": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "unit_id",
                        "revision"
                      ],
                      "properties": {
                        "unit_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "revision": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 4294967295
                        }
                      }
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8192
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "kind",
              "unit_refs",
              "brief"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "kind": {
                "const": "single_illustration"
              },
              "unit_refs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "unit_id",
                    "revision"
                  ],
                  "properties": {
                    "unit_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4294967295
                    }
                  }
                }
              },
              "brief": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            }
          }
        ]
      }
    }
  }
}
