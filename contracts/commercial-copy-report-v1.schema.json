{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:storytelling:commercial-copy-report:1",
  "title": "Storytelling CommercialCopyReportV1",
  "$comment": "SPDX-License-Identifier: MIT. A current reference proves ID/revision identity only; it does not establish semantic support or truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "copy_id", "copy_revision", "evidence_document_id", "purpose", "audience", "claims", "call_to_action", "reference_scope"],
  "properties": {
    "schema_version": { "const": 1 },
    "copy_id": { "$ref": "#/$defs/id" },
    "copy_revision": { "$ref": "#/$defs/revision" },
    "evidence_document_id": { "$ref": "#/$defs/id" },
    "purpose": { "$ref": "#/$defs/shortText" },
    "audience": { "$ref": "#/$defs/shortText" },
    "claims": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/claimReport" } },
    "call_to_action": { "$ref": "#/$defs/claimReport" },
    "reference_scope": { "const": "reference-identity-and-revision-only" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 512 },
    "text": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "claimReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "wording", "reference_status", "evidence_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["factual_claim", "creative_proposal"] },
        "wording": { "$ref": "#/$defs/text" },
        "reference_status": { "enum": ["current", "missing", "not_applicable", "revised", "dangling", "unknown_revision"] },
        "evidence_refs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit_id", "revision", "current_revision", "cited_source_origin", "cited_source_text", "reference_status"],
            "properties": {
              "unit_id": { "$ref": "#/$defs/id" },
              "revision": { "$ref": "#/$defs/revision" },
              "current_revision": { "oneOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }] },
              "cited_source_origin": { "oneOf": [{ "enum": ["supplied_observation", "author_interpretation", "creative_proposal"] }, { "type": "null" }] },
              "cited_source_text": { "oneOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
              "reference_status": { "enum": ["current", "revised", "dangling", "unknown_revision"] }
            }
          }
        }
      }
    }
  }
}
