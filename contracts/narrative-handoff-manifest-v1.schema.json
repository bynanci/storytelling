{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:storytelling:narrative-handoff-manifest:1",
  "title": "Storytelling NarrativeHandoffManifestV1",
  "$comment": "SPDX-License-Identifier: MIT. Shape constraints only. Register narrative-revision-ledger-v1.schema.json and narrative-document-v1.schema.json under their URN IDs. Replay, scope and complete component coverage require the pure engine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "ledger",
    "change_id",
    "sources",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest_id": {
      "$ref": "#/$defs/id"
    },
    "ledger": {
      "$ref": "urn:storytelling:narrative-revision-ledger:1"
    },
    "change_id": {
      "$ref": "#/$defs/id"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "medium": {
      "enum": [
        "text",
        "image",
        "audio"
      ]
    },
    "representation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "media_kind",
            "relative_path",
            "sha256"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "media_kind": {
              "$ref": "#/$defs/medium"
            },
            "relative_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "description": "Runtime rejects absolute paths, empty/dot/dot-dot segments, backslashes, colons and control characters."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "media_kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "description"
            },
            "media_kind": {
              "$ref": "#/$defs/medium"
            },
            "text": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "transcript"
            },
            "text": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "variant_id",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "creative_proposal"
            },
            "variant_id": {
              "$ref": "#/$defs/id"
            },
            "text": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "media_kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "missing"
            },
            "media_kind": {
              "$ref": "#/$defs/medium"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "revision",
        "representation"
      ],
      "properties": {
        "unit_id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "representation": {
          "$ref": "#/$defs/representation"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unit_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "unit_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "medium",
        "variant_id",
        "components"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "medium": {
          "$ref": "#/$defs/medium"
        },
        "variant_id": {
          "$ref": "#/$defs/id"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    }
  }
}
