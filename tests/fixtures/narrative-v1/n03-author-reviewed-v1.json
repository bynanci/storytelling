{
  "schema_version": 1,
  "document_id": "door-repair",
  "document_revision": 2,
  "purpose": "呈現兩位鄰居一起處理共用木門的小事。",
  "audience": "社區電子報讀者",
  "units": [
    {
      "id": "S01",
      "revision": 1,
      "origin": "supplied_observation",
      "text": "星期六上午，共用木門旁放著一個工具箱；阿梅和阿安站在門邊。",
      "based_on": []
    },
    {
      "id": "S02",
      "revision": 1,
      "origin": "supplied_observation",
      "text": "阿梅扶住門；阿安收緊上方鉸鏈的一顆螺絲。",
      "based_on": []
    },
    {
      "id": "S03",
      "revision": 1,
      "origin": "supplied_observation",
      "text": "兩人試關一次；這一次門沒有磨到地面。",
      "based_on": []
    },
    {
      "id": "S04",
      "revision": 1,
      "origin": "supplied_observation",
      "text": "兩人把工具收回工具箱。",
      "based_on": []
    },
    {
      "id": "I01",
      "revision": 1,
      "origin": "author_interpretation",
      "text": "一起處理一件小事，可以呈現鄰里互助。",
      "based_on": [
        {
          "unit_id": "S02",
          "revision": 1
        },
        {
          "unit_id": "S03",
          "revision": 1
        }
      ]
    },
    {
      "id": "C01",
      "revision": 1,
      "origin": "creative_proposal",
      "text": "一把想像的紅傘靠在木門旁的圍欄上。",
      "based_on": [
        {
          "unit_id": "S01",
          "revision": 1
        }
      ]
    },
    {
      "id": "C02",
      "revision": 1,
      "origin": "creative_proposal",
      "text": "以較寬近景同時容納上方鉸鏈、螺絲與兩人手部；收緊工具只在工作者手邊，不指定種類，工具箱留在畫外。門框作局部背景，不指定室內空間。手部位置、裁切與景深是本版構圖提案，不是現場觀察。",
      "based_on": [
        {
          "unit_id": "S02",
          "revision": 1
        }
      ]
    }
