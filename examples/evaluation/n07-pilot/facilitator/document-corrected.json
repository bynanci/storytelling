  "purpose": "呈現兩位鄰居一起處理共用木門的小事。",
  "audience": "社區電子報讀者",
  "units": [
    {
      "id": "S01",
      "revision": 2,
      "origin": "supplied_observation",
      "text": "星期六上午，共用木門旁放著一個工具箱；阿菊和阿哲站在門邊。",
      "based_on": []
    },
    {
      "id": "S02",
      "revision": 2,
      "origin": "supplied_observation",
      "text": "阿菊扶住門；阿哲收緊上方鉸鏈的一顆螺絲。",
      "based_on": []
    },
    {
      "id": "S03",
      "revision": 1,
      "origin": "supplied_observation",
      "text": "兩人試關一次；這一次門沒有磨到地面。",
      "based_on": []
    },
    {
      "id": "S04",
      "revision": 1,
      "origin": "supplied_observation",
      "text": "兩人把工具收回工具箱。",
      "based_on": []
    },
    {
      "id": "I01",
      "revision": 2,
      "origin": "author_interpretation",
      "text": "一起處理一件小事，可以呈現鄰里互助。",
      "based_on": [
        {
          "unit_id": "S02",
          "revision": 2
        },
        {
          "unit_id": "S03",
          "revision": 1
        }
      ]
    },
    {
      "id": "C01",
      "revision": 2,
      "origin": "creative_proposal",
      "text": "一把想像的紅傘靠在木門旁的圍欄上。",
