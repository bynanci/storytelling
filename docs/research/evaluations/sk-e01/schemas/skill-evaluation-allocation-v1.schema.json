{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bynanci/storytelling/main/docs/research/evaluations/sk-e01/schemas/skill-evaluation-allocation-v1.schema.json",
  "title": "Private Storytelling skill-evaluation allocation key V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["allocation_key_version", "evaluation_id", "presentation_seed", "allocations"],
  "properties": {
    "allocation_key_version": {"const": "skill-evaluation-allocation/v1"},
    "evaluation_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "presentation_seed": {"type": "integer", "minimum": 0},
    "allocations": {"type": "array", "minItems": 2, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "text_id", "run_id", "generation_id", "condition", "provenance_status", "evidence_ref", "skill_git_commit", "skill_sha256", "presentation_position"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "text_id": {"type": "string", "pattern": "^T-[23456789ABCDEFGHJKMNPQRSTVWXYZ]{6}$"},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "generation_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "condition": {"enum": ["skill_on", "skill_off", "unknown"]},
        "provenance_status": {"enum": ["observed", "declared", "synthetic", "unknown"]},
        "evidence_ref": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "skill_git_commit": {"type": ["string", "null"], "pattern": "^([a-f0-9]{40})?$"},
        "skill_sha256": {"type": ["string", "null"], "pattern": "^([a-f0-9]{64})?$"},
        "presentation_position": {"type": "integer", "minimum": 1}
      }
    }}
  }
}
