{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bynanci/storytelling/main/docs/research/evaluations/sk-e01/schemas/skill-evaluation-blind-v1.schema.json",
  "title": "Blinded Storytelling skill evaluation packet V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["blind_packet_version", "evaluation_id", "cases"],
  "properties": {
    "blind_packet_version": {"const": "skill-evaluation-blind/v1"},
    "evaluation_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "cases": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "task", "audience", "packet_version", "prompt", "evidence_packet", "drafts"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "task": {"type": "string"},
        "audience": {"type": "string"},
        "packet_version": {"type": "string"},
        "prompt": {"type": "string"},
        "evidence_packet": {"type": "string"},
        "drafts": {"type": "array", "minItems": 2, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["text_id", "text"],
          "properties": {
            "text_id": {"type": "string", "pattern": "^T-[23456789ABCDEFGHJKMNPQRSTVWXYZ]{6}$"},
            "text": {"type": "string"}
          }
        }}
      }
    }}
  }
}
