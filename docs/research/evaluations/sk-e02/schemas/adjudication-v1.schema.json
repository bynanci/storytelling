{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bynanci/storytelling/main/docs/research/evaluations/sk-e02/schemas/adjudication-v1.schema.json",
  "title": "Storytelling skill evaluation claim adjudication V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "evidence_plan_sha256", "claim_checks", "packet_scope_violations", "packet_source_mismatches"],
  "properties": {
    "schema_version": {"const": "skill-evaluation-adjudication/v1"},
    "record_kind": {"enum": ["adjudication", "synthetic_fixture"]},
    "evidence_plan_sha256": {"$ref": "#/$defs/sha256"},
    "claim_checks": {"type": "array", "items": {"$ref": "#/$defs/claimCheck"}},
    "packet_scope_violations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}},
    "packet_source_mismatches": {"type": "array", "items": {"$ref": "#/$defs/annotation"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "detail", "evidence_location"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1},
        "evidence_location": {"type": "string", "minLength": 1}
      }
    },
    "claimCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "source_access_status", "support_state", "evidence_locations", "note"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "source_access_status": {"enum": ["available", "unavailable", "not_attempted", "not_recorded"]},
        "support_state": {"enum": ["supported", "contradicted", "insufficient", "unavailable"]},
        "evidence_locations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "note": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"source_access_status": {"enum": ["unavailable", "not_attempted", "not_recorded"]}}, "required": ["source_access_status"]},
          "then": {"properties": {"support_state": {"enum": ["insufficient", "unavailable"]}}}
        }
      ]
    }
  }
}
