{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:storytelling:proposal:readonly-transport:v1:request",
  "title": "PROPOSED read-only request header V1, not accepted",
  "description": "Header structure only. Protocol adds byte/depth/duplicate-key/lexical-integer/framing checks and deterministic diagnostic order. Domain source buffers are not pre-parsed.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "storytelling.readonly"
    },
    "wire_version": {
      "const": 1
    },
    "facade_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9._-]"
      }
    },
    "operation": {
      "enum": [
        "describe",
        "validate_plan",
        "render_narrative",
        "track_revisions",
        "query_impact",
        "video_coverage",
        "plan_story",
        "prepare_story_review",
        "check_story_review"
      ]
    },
    "params": {
      "type": "object"
    },
    "buffers": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/buffer"
      }
    }
  },
  "required": [
    "protocol",
    "wire_version",
    "facade_version",
    "request_id",
    "operation",
    "params",
    "buffers"
  ],
  "$defs": {
    "buffer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "name",
        "byte_length"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "describe"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "properties": {},
            "required": []
          },
          "buffers": {
            "type": "array",
            "minItems": 0,
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "validate_plan"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "properties": {},
            "required": []
          },
          "buffers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
              {
                "allOf": [
                  {
                    "$ref": "#/$defs/buffer"
                  },
                  {
                    "properties": {
                      "name": {
                        "const": "document"
                      }
                    }
                  }
                ]
              }
            ],
            "items": false
          }
        }
      }
    },
    {
      "if": {
