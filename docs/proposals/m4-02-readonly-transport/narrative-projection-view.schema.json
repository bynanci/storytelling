{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:storytelling:proposal:readonly-transport:v1:narrative-projection",
  "title": "PROPOSED binding-only narrative projection view V1",
  "description": "Not NarrativeDocumentV2 or a new core serializer. Header view name versions this projection separately from schema_version.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "document_id": {
      "type": "string"
    },
    "document_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "purpose": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "variants": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "spoken_outline"
              },
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "beats": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/beat"
                }
              }
            },
            "required": [
              "kind",
              "id",
              "name",
              "beats"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "single_illustration"
              },
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/source"
                }
              },
              "brief": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id",
              "name",
              "sources",
              "brief"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "document_id",
    "document_revision",
    "purpose",
    "audience",
    "variants"
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "origin": {
          "enum": [
            "supplied_observation",
            "author_interpretation",
            "creative_proposal"
          ]
        }
      },
      "required": [
        "unit_id",
        "revision",
        "origin"
      ]
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "text"
      ]
    }
  }
}
