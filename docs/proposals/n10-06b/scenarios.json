        {
          "operation": "set",
          "pointer": "/coverage/mappings/0/source_range/end",
          "value": "1e2"
        },
        {
          "operation": "set",
          "pointer": "/coverage/mappings/1",
          "value": {
            "unit_ref": {
              "unit_id": "S03",
              "revision": 1
