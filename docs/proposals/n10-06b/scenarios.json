      "purpose_zh_TW": "多欄位提示不能取代實際第一個 helper 錯誤。",
      "base_fixture": "../../../tests/fixtures/n10-06a-draft/seconds-unresolved.draft.json",
      "edits": [
        {
          "operation": "set",
          "pointer": "/coverage/mappings/0/source_range/start",
          "value": "-1"
