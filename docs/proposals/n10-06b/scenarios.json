          "unit_id": "S02",
          "revision": 1,
          "declared_mapping_status": "mapped",
          "mapping_indices": [
            0
          ]
        },
        {
          "unit_id": "S03",
          "revision": 1,
          "declared_mapping_status": "mapped",
          "mapping_indices": [
            1
          ]
        }
      ],
      "expected_v1_diagnostics": [],
      "forbidden_labels": [
        "media_verified",
        "export_ready",
        "execution_authorized",
        "實體影片已驗證",
        "可執行匯出"
      ]
    },
    {
