{
  "proposal_version": "n10-06b.scenarios.1",
  "record_kind": "synthetic_design_assertions",
  "status": "proposed_pending_G2",
  "design_base_commit": "59516f24f4d829a3d695c115d2f94e208a78cdea",
  "source_context": "New MIT design cases using the repository-authored synthetic A fixture. Edits are test-plan instructions, not an implemented patch API.",
  "operations_note": "set replaces/adds the value at an RFC6901-style pointer; remove deletes that array item/property; reverse_array reverses the specified array. A future test harness applies these only in memory and never alters the base fixture.",
  "shared_invariants": [
    "Every input selection remains visible in original order with exact supplied unit_id and revision.",
    "Mapped and unresolved remain explicit; absent or invalid mapping rows are not synthesized, filtered or repaired.",
    "IN is inclusive and OUT exclusive; show original unit, exact conversion where interpretable and fixed/indexed input/output JSONPaths.",
    "Advisory hints are labeled non-authoritative; only the full unchanged A/V1 result supplies actual first-error code/path and exit.",
    "Raw syntax, duplicate, depth or budget failure prevents decoding rows or hints.",
    "Invalid input emits no V1 document; valid unresolved input may print V1 declaration JSON through unchanged A only and still blocks planning.",
    "File bytes, metadata, content suitability, host capability and execution authority remain unverified by this preview.",
    "No implicit writes, media reads/probes, model/network calls, host invocation, self-approval or unknown retry."
  ],
  "scenarios": [
    {
      "id": "B01-valid-unresolved",
      "purpose_en": "Preserve selected order, exact conversion and missing footage.",
      "purpose_zh_TW": "保留選取順序、精確換算與缺素材。",
      "base_fixture": "../../../tests/fixtures/n10-06a-draft/seconds-unresolved.draft.json",
      "edits": [],
      "expected_authority": {
        "stage": "v1",
        "v1_state": "valid",
        "ready_for_planning": false,
        "v1_json_allowed": true,
        "exit": 0,
        "label_zh_TW": "宣告輸入有效；缺素材仍阻擋規劃",
        "label_en": "Declaration input valid; unresolved coverage blocks planning"
      },
      "expected_rows": [
        {
          "unit_id": "S02",
          "revision": 1,
          "declared_mapping_status": "mapped",
          "mapping_indices": [
            0
          ]
        },
        {
          "unit_id": "S03",
          "revision": 1,
          "declared_mapping_status": "unresolved",
          "mapping_indices": [
            1
          ]
        }
      ],
      "expected_first_range": {
        "start": {
          "numerator": "5",
          "denominator": "2"
        },
        "end": {
          "numerator": "9",
          "denominator": "2"
        }
      },
      "expected_v1_diagnostics": [
        {
          "code": "video_coverage.unresolved_required",
          "path": "$.mappings[1]"
        }
      ],
      "must_preserve_reason": "No video asset was selected for this unit."
    },
