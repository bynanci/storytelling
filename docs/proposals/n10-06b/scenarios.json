            "status": "mapped",
            "asset_ref": {
              "asset_id": "CLIP-01",
              "revision": 1
            },
            "source_range": {
              "unit": "frames",
              "start_frame": "75",
              "end_frame": "135",
              "fps": {
                "numerator": "0",
                "denominator": "1"
              },
              "timing": "variable"
            }
          }
        }
