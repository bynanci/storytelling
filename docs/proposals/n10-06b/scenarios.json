      "expected_rows": [
        {
          "unit_id": "S02",
          "revision": 1,
          "declared_mapping_status": "mapped",
          "mapping_indices": [
            0
          ]
        },
        {
          "unit_id": "S03",
          "revision": 1,
          "declared_mapping_status": "mapped",
          "mapping_indices": [
            1
          ]
        }
